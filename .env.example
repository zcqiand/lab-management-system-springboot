# lab-management-system-springboot — 开发期环境变量模板
#
# application.yml 是 SSOT；本文件列出可用 env override（Spring Boot 标准
# relaxed binding 把 yaml 的 ${VAR:default} 自动覆盖；无需改 yaml）。

# —— Server ——
SERVER_PORT=8080

# —— Database（lab_dev 数据库） ——
# 默认 jdbc:postgresql://100.79.128.25:5432/lab_dev（application.yml 默认）
# 三选一覆盖：LAB_DB / SPRING_DATASOURCE_URL / JDBC_URL
SPRING_DATASOURCE_URL=jdbc:postgresql://100.79.128.25:5432/lab_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme
LAB_DB=lab_dev

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发, no-sso profile 兜底) ——
# 镜像 saas-identity-platform-* + lab-management-system-msw 六仓共享同一 JWT_SIGNING_KEY
# (≥32B 硬约束): SSO 模式验签 saas 签发的 token, no-sso 模式 LabJwtSigner 真签 HS256。
# Phase 4 env 对称化后统一命名（之前是 LAB_JWT_SECRET → JWT_SIGNING_KEY）。
# prod 路径：deploy 脚本首启自举随机密钥持久化进 springboot.env。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# 默认 no-sso profile（in-memory fallback），prod 切 sso profile 走真实 saas
LAB_SAAS_BASE_URL=http://localhost:3001
SAAS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001