# lab-management-system-springboot — 开发期环境变量模板
#
# application.yml 是 SSOT；本文件列出可用 env override（Spring Boot 标准
# relaxed binding 把 yaml 的 ${VAR:default} 自动覆盖；无需改 yaml）。

# —— Server ——
SERVER_PORT=8080

# —— Database（lab_dev 数据库，全家族统一四件套 DATABASE_URL/USER/PASSWORD/NAME） ——
# 默认 jdbc:postgresql://100.79.128.25:5432/lab_dev（application.yml 默认）
# URL/USER/PASSWORD 三项直接覆盖连接；DATABASE_NAME 供切库工具（db-env.sh）用，
# yml 不读它。JDBC_URL 是 db-env.sh 兼容兜底（application.yml 第二层占位符）。
DATABASE_URL=jdbc:postgresql://100.79.128.25:5432/lab_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=lab_dev

# —— JWT (HS256, ADR-0008: 真后端 OAuth + JWT 签发, no-sso profile 兜底) ——
# 镜像 saas-identity-platform-* + lab-management-system-msw 六仓共享同一 JWT_SIGNING_KEY
# (≥32B 硬约束): SSO 模式验签 saas 签发的 token, no-sso 模式 LabJwtSigner 真签 HS256。
# Phase 4 env 对称化后统一命名（之前是 LAB_JWT_SECRET → JWT_SIGNING_KEY）。
# prod 路径：deploy 脚本首启自举随机密钥持久化进 springboot.env。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600

# —— saas OAuth (SSO 模式直连 saas IdP, ADR-0009) ——
# 默认 no-sso profile（in-memory fallback），prod 切 sso profile 走真实 saas。
# 以下 7 个 key 是 application.yml:68-84 lab.sso 段的 env override 真名,
# deploy 脚本必写（2026-08-28 与 .env.production key 集合对齐,曾长期缺席:
# prod 靠 yml 占位默认值静默兜底,CLIENT_SECRET 兜底导致 saas 400/401）。
LAB_SAAS_BASE_URL=http://localhost:3000
# IdP 登录页 base（authorizeUrl 拼 {login-url}/login）,由 saas 前端提供
LAB_SSO_LOGIN_URL=http://localhost:3000
# lab-mgmt 在 saas 注册的 OAuth client（V014/V015 收敛为固定 UUID,3 个 saas 后端同源）
LAB_SAAS_CLIENT_ID=11111111-1111-1111-1111-111111111111
# saas 侧配置的 client secret;dev 用 seed 值,prod 由 VPS env-file 注入
LAB_SAAS_CLIENT_SECRET=lab-mgmt-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# SSO 回调页（lab 前端 login 页,saas 302 回这里）
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5173/login
# 服务账号（密码登录拉菜单快照）:dev 默认 alice（saas seeds role-admin）
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456

# —— CORS（application.yml:86 读 LAB_CORS_ALLOWED_ORIGINS；勿写成 saas 家族的 SAAS_CORS_*） ——
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000