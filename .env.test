# .env.test — lab-management-system-springboot L4 测试期覆盖
#
# JWT_SIGNING_KEY 与 lab-management-system-msw 共享 (≥32B 硬约束)。
# 与 saas-identity-platform-springboot .env.test 共享同一 dev key，
# 跨仓 L4 测试可互签互验。Phase 4 env 对称化后 LAB_JWT_SECRET → JWT_SIGNING_KEY。

JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_AUDIENCE=lab-management-system-clients
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# === 以下 key 与 .env.example 全集对齐（T10: key 集合拉齐,值用 example dev 值）===
SERVER_PORT=5205
DATABASE_URL=jdbc:postgresql://100.79.128.25:5432/lab_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=lab_dev
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=11111111-1111-1111-1111-111111111111
LAB_SAAS_CLIENT_SECRET=lab-mgmt-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5202/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_AUTH_DEV_PASSWORD=dev123456
LAB_CORS_ALLOWED_ORIGINS=http://localhost:5201,http://localhost:5202,http://localhost:5203,http://localhost:5101
