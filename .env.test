# .env.test — lab-management-system-springboot L4 测试期覆盖
#
# LAB_JWT_SECRET 与 lab-management-system-msw 共享 (≥32B 硬约束)。
# 与 saas-identity-platform-springboot .env.test 共享同一 dev key，
# 跨仓 L4 测试可互签互验。

LAB_JWT_SECRET=dev-key-32-bytes-minimum-length!
LAB_JWT_ISSUER=lab-management-system
LAB_JWT_AUDIENCE=lab-management-system-clients
LAB_JWT_TTL_SECONDS=3600